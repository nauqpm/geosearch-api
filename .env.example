# Development PostgreSQL/PostGIS container (127.0.0.1:55432, persistent volume).
# Used by Alembic CLI migrations and application runtime.
DEV_DB_USER=user
DEV_DB_PASSWORD=dev_password
DEV_DB_NAME=geosearch_dev
DATABASE_URL=postgresql+psycopg://user:dev_password@127.0.0.1:55432/geosearch_dev

# Isolated test PostgreSQL/PostGIS container (127.0.0.1:55433, ephemeral tmpfs).
# Used exclusively by pytest and integration test fixtures (never shares host:port with DATABASE_URL).
TEST_DB_USER=user
TEST_DB_PASSWORD=test_password
TEST_DB_NAME=geosearch_test
TEST_DATABASE_URL=postgresql+psycopg://user:test_password@127.0.0.1:55433/geosearch_test
